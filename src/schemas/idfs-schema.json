{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IDFS Dataset Schema",
  "description": "Schema definition for ASPERA-3 IDFS datasets (PDS compliance simulation)",
  "definitions": {
    "ELS": {
      "type": "object",
      "required": ["energyRange", "electronFlux", "timestamp"],
      "properties": {
        "energyRange": { "type": "number", "minimum": 0 },
        "electronFlux": { "type": "number", "minimum": 0 },
        "timestamp": { "type": "string" }
      },
      "additionalProperties": true
    },
    "IMA": {
      "type": "object",
      "required": ["mass", "energy", "angle", "amuPerQ", "ionFlux"],
      "properties": {
        "mass": { "type": "number", "minimum": 0 },
        "energy": { "type": "number", "minimum": 0 },
        "angle": { "type": "number" },
        "amuPerQ": { "type": "number", "minimum": 1, "maximum": 1000000 },
        "ionFlux": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "NPD": {
      "type": "object",
      "required": ["hydrogenFlux", "oxygenFlux", "energyRange"],
      "properties": {
        "hydrogenFlux": { "type": "number" },
        "oxygenFlux": { "type": "number", "minimum": 0 },
        "energyRange": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
