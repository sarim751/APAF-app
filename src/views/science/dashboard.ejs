<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>APAF-Lite | Science Operations Terminal</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Synchronized Code Editor Window */
    .editor-container {
      position: relative;
      background: #030712;
      border: 1px solid var(--border-glow);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.9), 0 0 20px rgba(56, 189, 248, 0.12);
    }
    .editor-header {
      background: rgba(10, 17, 36, 0.95);
      border-bottom: 1px solid var(--border-dim);
      padding: 0.65rem 1.15rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .editor-body-wrapper {
      display: flex;
      position: relative;
      min-height: 230px;
      max-height: 380px;
      background: #030712;
      overflow: hidden;
    }
    .editor-gutter {
      width: 42px;
      padding: 1rem 0.4rem 1rem 0.6rem;
      background: rgba(6, 11, 24, 0.95);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
      color: #475569;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.55;
      text-align: right;
      user-select: none;
    }
    .editor-surface {
      position: relative;
      flex-grow: 1;
      height: 250px;
      overflow: hidden;
    }
    .editor-highlight {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.55;
      white-space: pre-wrap;
      word-break: break-all;
      color: #94a3b8;
      overflow-y: auto;
      pointer-events: none;
      z-index: 1;
    }
    .editor-textarea {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.55;
      white-space: pre-wrap;
      word-break: break-all;
      background: transparent;
      color: transparent;
      caret-color: #38bdf8;
      border: none;
      outline: none;
      resize: none;
      z-index: 2;
      overflow-y: auto;
    }
  </style>
</head>
<body>
  <canvas id="spaceCanvas"></canvas>

  <div class="content-wrapper">
    <!-- Top Mission Status Bar -->
    <div class="mission-status-bar">
      <div class="mission-indicator">
        <span class="pulse-dot"></span>
        <span>SCIENCE OPERATIONS TERMINAL &bull; RESTRICTED ENVIRONMENT</span>
      </div>
      <div class="mission-clocks">
        <span id="marsSol">MEX ORBIT #23842</span>
        <span id="utcClock">UTC --:--:--</span>
      </div>
    </div>

    <!-- Header -->
    <header>
      <div class="title-group">
        <h1>ASPERA-3 Operations Control</h1>
        <p>Telemetry Ingestion Pipeline &bull; IDFS Generation &bull; Science Archive Management</p>
      </div>
      <div class="nav-cluster">
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border-glow); padding: 0.4rem 0.9rem; border-radius: 8px; font-size: 0.85rem; font-family: var(--font-mono);">
          USER: <strong style="color: var(--accent-cyan);"><%= user.username %></strong> 
          <span style="color: var(--text-dim); margin: 0 0.3rem;">|</span>
          ROLE: <span style="color: <%= user.role === 'ADMIN' ? '#f59e0b' : '#34d399' %>;"><%= user.role %></span>
        </div>
        <% if (user.role === 'ADMIN') { %>
          <a href="/admin/logs" class="btn">
            <span>🛡️ System Logs</span>
          </a>
        <% } %>
        <a href="/" class="btn">
          <span>🌐 Public Portal</span>
        </a>
        <a href="/auth/logout" class="btn" style="border-color: rgba(239, 68, 68, 0.3); color: #fca5a5;">Sign Out</a>
      </div>
    </header>

    <main>
      <!-- Telemetry Ingestion Operations Terminal -->
      <div class="terminal-card" id="ingestPanel">
        <div class="terminal-header">
          <div>
            <h3>
              <span style="display: inline-block; animation: pulseBeacon 2s infinite cubic-bezier(0.66, 0, 0, 1); width: 8px; height: 8px; background: var(--accent-cyan); border-radius: 50%;"></span>
              SIMULATE TELEMETRY DOWNLINK (APAF-FR-01 / FR-04)
            </h3>
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim);">GROUND STATION PROTOCOL: ESOC/DDS-V1</span>
          </div>

          <!-- Mode Switcher: Form vs Code -->
          <div class="hud-view-toggle">
            <button type="button" class="toggle-btn active" id="btnModeForm" onclick="setViewMode('form')">
              🎛️ Parameter Inspector
            </button>
            <button type="button" class="toggle-btn" id="btnModeCode" onclick="setViewMode('code')">
              💻 JSON Console
            </button>
          </div>
        </div>

        <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.25rem;">
          Select a pre-configured scientific telemetry profile. Adjust physical instrument parameters in the interactive console or inspect raw packet structure.
        </p>

        <!-- Aesthetic Template Cards Grid -->
        <div class="template-grid">
          <!-- ELS Template Card -->
          <div class="template-card active" id="card-tpl-ELS" onclick="selectTemplate('ELS')">
            <div class="template-card-header">
              <div class="template-name">⚡ ELS Spectrometer</div>
              <span class="template-tag">CH-01</span>
            </div>
            <div class="template-desc">Single electron flux and energy stream. Nominal science baseline.</div>
            <div class="template-meta-row">
              <span>Cleaned: 1 (OK)</span>
              <span style="color: var(--accent-cyan);">ASPERA-3</span>
            </div>
          </div>

          <!-- IMA Template Card -->
          <div class="template-card" id="card-tpl-IMA" onclick="selectTemplate('IMA')">
            <div class="template-card-header">
              <div class="template-name">🧬 IMA Mass Analyzer</div>
              <span class="template-tag">CH-02</span>
            </div>
            <div class="template-desc">Multi-species ion matrix with mass-to-charge (1–1e6 amu/q) boundary check.</div>
            <div class="template-meta-row">
              <span>Cleaned: 1 (OK)</span>
              <span style="color: var(--accent-amber);">ASPERA-3</span>
            </div>
          </div>

          <!-- NPD Template Card -->
          <div class="template-card" id="card-tpl-NPD" onclick="selectTemplate('NPD')">
            <div class="template-card-header">
              <div class="template-name">⚛️ NPD Atom Detector</div>
              <span class="template-tag">CH-03</span>
            </div>
            <div class="template-desc">Energetic neutral atom flux for hydrogen (H-ENA) and oxygen (O-ENA).</div>
            <div class="template-meta-row">
              <span>Cleaned: 1 (OK)</span>
              <span style="color: var(--accent-mars);">ASPERA-3</span>
            </div>
          </div>

          <!-- Raw Uncleaned Recoverable Template Card (TC-08) -->
          <div class="template-card" id="card-tpl-UNCLEANED" onclick="selectTemplate('UNCLEANED')">
            <div class="template-card-header">
              <div class="template-name" style="color: #fbbf24;">⚠️ Raw Recoverable (TC-08)</div>
              <span class="template-tag" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3);">FR-04</span>
            </div>
            <div class="template-desc">Uncleaned ELS (`cleaned: 0`). Auto-triggers intermediate recovery file (Status OK)!</div>
            <div class="template-meta-row">
              <span style="color: #fbbf24;">Cleaned: 0 (RAW)</span>
              <span style="color: var(--text-dim);">Ground Recv</span>
            </div>
          </div>

          <!-- Raw NPD Corrupt / Blocked Template Card (TC-09) -->
          <div class="template-card" id="card-tpl-CORRUPT_NPD" onclick="selectTemplate('CORRUPT_NPD')">
            <div class="template-card-header">
              <div class="template-name" style="color: #ef4444;">🚫 Corrupt NPD (TC-09)</div>
              <span class="template-tag" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border-color: rgba(239, 68, 68, 0.3);">BLOCKED</span>
            </div>
            <div class="template-desc">Corrupt uncleaned NPD (`cleaned: 0`). Missing fields halt pipeline at BLOCKED!</div>
            <div class="template-meta-row">
              <span style="color: #ef4444;">Cleaned: 0 (FATAL)</span>
              <span style="color: #fca5a5;">No IDFS Created</span>
            </div>
          </div>
        </div>

        <!-- Mode A: Interactive Visual Parameter HUD Form -->
        <div class="hud-form-panel" id="hudFormPanel">
          <div class="hud-form-grid" id="hudFieldsContainer">
            <!-- Dynamically populated based on active template -->
          </div>
        </div>

        <!-- Mode B: Sci-Fi IDE Code Window (Hidden by default, toggleable) -->
        <div class="editor-container" id="editorWindow" style="display: none;">
          <div class="editor-header">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <div class="window-dots">
                <span class="window-dot dot-red"></span>
                <span class="window-dot dot-yellow"></span>
                <span class="window-dot dot-green"></span>
              </div>
              <div class="code-window-tab">
                <span>📄 telemetry_packet.json</span>
                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent-emerald);"></span>
              </div>
            </div>

            <div class="code-window-actions">
              <button type="button" class="code-action-btn" onclick="copyJsonToClipboard()">
                <span>📋 Copy</span>
              </button>
              <button type="button" class="code-action-btn" onclick="formatJsonEditor()">
                <span>✨ Format</span>
              </button>
              <button type="button" class="code-action-btn" onclick="regeneratePacketId()">
                <span>🎲 New ID</span>
              </button>
            </div>
          </div>

          <!-- Synchronized Highlighted Editor Body -->
          <div class="editor-body-wrapper">
            <div class="editor-gutter" id="editorGutter">
              1<br>2<br>3<br>4<br>5<br>6<br>7<br>8<br>9<br>10<br>11<br>12
            </div>
            <div class="editor-surface">
              <div class="editor-highlight" id="editorHighlight"></div>
              <textarea id="telemetryJson" class="editor-textarea" spellcheck="false" placeholder="Telemetry packet payload JSON..."></textarea>
            </div>
          </div>

          <!-- Editor Metadata Ticker Bar -->
          <div class="code-meta-bar">
            <div class="code-meta-item">
              <span>TARGET SOURCE: <strong>ASPERA-3 / MEX</strong></span>
            </div>
            <div class="code-meta-item">
              <span>INSTRUMENT: <strong id="metaInstrument">ELS</strong></span>
            </div>
            <div class="code-meta-item">
              <span>PACKET ID: <strong id="metaPacketId">PKT-ELS-1234</strong></span>
            </div>
            <div class="code-meta-item">
              <span>CLEANED FLAG: <strong id="metaCleaned">1 (PRE-CLEANED)</strong></span>
            </div>
            <div class="code-meta-item">
              <span>SIZE: <strong id="metaBytes">0 B</strong></span>
            </div>
          </div>
        </div>

        <div style="margin-top: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span class="pulse-dot" style="width: 6px; height: 6px;"></span>
            <span style="font-size: 0.78rem; color: var(--text-dim); font-family: var(--font-mono);">
              FLOW: INGEST &rarr; CLEANUP (IF NEEDED) &rarr; IDFS GENERATION &rarr; LOCAL ARCHIVE
            </span>
          </div>
          <button type="button" class="btn btn-primary" id="btnSubmitIngest" onclick="submitTelemetry()" style="padding: 0.65rem 1.4rem; font-size: 0.95rem;">
            <span>🚀 Transmit to Ingestion Pipeline</span>
          </button>
        </div>
      </div>

      <!-- IDFS Datasets Section -->
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 2.5rem; margin-bottom: 0.75rem;">
        <div>
          <h2 style="font-family: var(--font-heading); font-size: 1.4rem;">IDFS Science Data Repository</h2>
          <p style="color: var(--text-muted); font-size: 0.85rem;">All generated datasets currently stored in local SwRI archive (<%= datasets.length %> total records)</p>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-cyan); display: flex; align-items: center; gap: 0.4rem;">
          <span class="pulse-dot"></span>
          <span>SWRI ARCHIVE ONLINE</span>
        </div>
      </div>

      <% if (datasets.length === 0) { %>
        <div class="telemetry-gauge-box" style="padding: 3rem 1rem; text-align: center; margin-top: 1rem; color: var(--text-muted);">
          No datasets recorded yet. Use the transmission console above to ingest telemetry packets.
        </div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Packet Ref</th>
                <th>Instrument</th>
                <th>Public Status</th>
                <th>Processed Scientific Telemetry</th>
                <th>Ingested Timestamp</th>
                <th>Operations</th>
              </tr>
            </thead>
            <tbody>
              <% datasets.forEach(function(ds) { 
                   const p = ds.data_json || {};
              %>
                <tr>
                  <td style="font-family: var(--font-mono); font-weight: 700; color: var(--accent-cyan);">
                    #<%= ds.id %>
                  </td>
                  <td style="font-family: var(--font-mono); color: var(--text-muted);">
                    Packet #<%= ds.packet_id %>
                  </td>
                  <td>
                    <span class="badge" style="background: rgba(56, 189, 248, 0.12); color: var(--accent-cyan); border: 1px solid rgba(56, 189, 248, 0.3);">
                      <%= ds.instrument %>
                    </span>
                  </td>
                  <td>
                    <% if (ds.public_released === 1) { %>
                      <span class="badge badge-live">● PUBLIC RELEASED</span>
                    <% } else { %>
                      <span class="badge badge-restricted">RESTRICTED (SCIENCE ONLY)</span>
                    <% } %>
                  </td>
                  <td>
                    <!-- Stylish Scientific Parameter Chips instead of raw code box -->
                    <div class="param-chip-cluster">
                      <% if (ds.instrument === 'ELS') { %>
                        <span class="param-chip"><span class="param-chip-key">energy:</span> <span class="param-chip-val"><%= p.energyRange %> eV</span></span>
                        <span class="param-chip"><span class="param-chip-key">flux:</span> <span class="param-chip-val"><%= Number(p.electronFlux).toLocaleString() %></span></span>
                      <% } else if (ds.instrument === 'IMA') { %>
                        <span class="param-chip"><span class="param-chip-key">amu/q:</span> <span class="param-chip-val"><%= p.amuPerQ %></span></span>
                        <span class="param-chip"><span class="param-chip-key">flux:</span> <span class="param-chip-val"><%= Number(p.ionFlux).toLocaleString() %></span></span>
                        <span class="param-chip"><span class="param-chip-key">angle:</span> <span class="param-chip-val"><%= p.angle %>°</span></span>
                      <% } else if (ds.instrument === 'NPD') { %>
                        <span class="param-chip"><span class="param-chip-key">H-flux:</span> <span class="param-chip-val"><%= Number(p.hydrogenFlux).toLocaleString() %></span></span>
                        <span class="param-chip"><span class="param-chip-key">O-flux:</span> <span class="param-chip-val"><%= Number(p.oxygenFlux).toLocaleString() %></span></span>
                      <% } else { %>
                        <span class="param-chip"><span class="param-chip-key">records:</span> <span class="param-chip-val">Validated</span></span>
                      <% } %>
                      <button type="button" class="btn-inspect" onclick='openPayloadModal(<%= ds.id %>, "<%= ds.instrument %>", `<%= JSON.stringify(p) %>`)'>
                        🔍 View Frame
                      </button>
                    </div>
                  </td>
                  <td style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted);">
                    <%= new Date(ds.created_at).toLocaleString() %>
                  </td>
                  <td>
                    <% if (user.role === 'ADMIN' && ds.public_released !== 1) { %>
                      <button class="btn btn-success" style="padding: 0.35rem 0.75rem; font-size: 0.78rem;" onclick="releaseDataset(<%= ds.id %>)">
                        <span>🔓 Release &rarr;</span>
                      </button>
                    <% } else if (ds.public_released === 1) { %>
                      <span style="font-size: 0.75rem; color: var(--accent-emerald); font-family: var(--font-mono); font-weight: 600;">ACTIVE IN PUBLIC</span>
                    <% } else { %>
                      <span style="font-size: 0.75rem; color: var(--text-dim); font-family: var(--font-mono);">ADMIN SIGN-OFF REQ</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </main>

    <!-- Footer -->
    <footer>
      <div>ASPERA-3 Processing and Archiving Facility (APAF-Lite) &bull; Science Operations Segment</div>
      <div style="font-family: var(--font-mono); color: var(--accent-cyan);">SWRI / IRF COLLABORATION</div>
    </footer>
  </div>

  <!-- Glassmorphic Payload Inspection Modal -->
  <div class="hud-modal-overlay" id="payloadModal">
    <div class="hud-modal-card">
      <div class="hud-modal-header">
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--accent-cyan);" id="modalTitle">
            IDFS Dataset Inspection
          </h3>
          <p style="font-size: 0.78rem; color: var(--text-dim); font-family: var(--font-mono);" id="modalSub">
            PDS-COMPLIANT ARCHIVAL STRUCTURE
          </p>
        </div>
        <button type="button" class="code-action-btn" onclick="closePayloadModal()" style="font-size: 1rem; padding: 0.3rem 0.6rem;">
          ✕
        </button>
      </div>
      <div class="hud-modal-body">
        <div class="code-viewer" style="margin-bottom: 1rem;">
          <pre id="modalJsonDisplay"></pre>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
          <button type="button" class="btn btn-primary" style="padding: 0.45rem 1rem; font-size: 0.82rem;" onclick="copyModalJson()">
            <span>📋 Copy Frame JSON</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="toastContainer"></div>

  <script src="/js/space-fx.js"></script>
  <script>
    let currentTemplateKey = 'ELS';
    let currentMode = 'form'; // 'form' or 'code'

    const templates = {
      ELS: {
        packetId: "PKT-ELS-" + Math.floor(1000 + Math.random() * 9000),
        source: "ASPERA-3",
        instrument: "ELS",
        cleaned: 1,
        payload: {
          energyRange: 550,
          electronFlux: 28400,
          timestamp: new Date().toISOString()
        }
      },
      IMA: {
        packetId: "PKT-IMA-" + Math.floor(1000 + Math.random() * 9000),
        source: "ASPERA-3",
        instrument: "IMA",
        cleaned: 1,
        payload: {
          mass: 16,
          energy: 420,
          angle: 15,
          amuPerQ: 16,
          ionFlux: 9100
        }
      },
      NPD: {
        packetId: "PKT-NPD-" + Math.floor(1000 + Math.random() * 9000),
        source: "ASPERA-3",
        instrument: "NPD",
        cleaned: 1,
        payload: {
          hydrogenFlux: 1250,
          oxygenFlux: 390,
          energyRange: 320
        }
      },
      UNCLEANED: {
        packetId: "PKT-ELS-RAW-" + Math.floor(1000 + Math.random() * 9000),
        source: "ASPERA-3",
        instrument: "ELS",
        cleaned: 0,
        payload: {
          rawEnergy: 620,
          rawFlux: 18500
        }
      },
      CORRUPT_NPD: {
        packetId: "PKT-NPD-CORRUPT-" + Math.floor(1000 + Math.random() * 9000),
        source: "ASPERA-3",
        instrument: "NPD",
        cleaned: 0,
        payload: {
          corrupt: true,
          noiseLevel: 999
        }
      }
    };

    let activePacket = JSON.parse(JSON.stringify(templates.ELS));

    const textarea = document.getElementById('telemetryJson');
    const highlightLayer = document.getElementById('editorHighlight');
    const gutter = document.getElementById('editorGutter');

    function setViewMode(mode) {
      currentMode = mode;
      const formBtn = document.getElementById('btnModeForm');
      const codeBtn = document.getElementById('btnModeCode');
      const formPanel = document.getElementById('hudFormPanel');
      const codePanel = document.getElementById('editorWindow');

      if (mode === 'form') {
        formBtn.classList.add('active');
        codeBtn.classList.remove('active');
        formPanel.style.display = 'block';
        codePanel.style.display = 'none';
        renderFormFields();
      } else {
        codeBtn.classList.add('active');
        formBtn.classList.remove('active');
        formPanel.style.display = 'none';
        codePanel.style.display = 'block';
        syncEditor();
      }
    }

    function toggleCleanedFlag() {
      const newCleaned = activePacket.cleaned === 1 ? 0 : 1;
      updatePacketField('cleaned', newCleaned);
      renderFormFields();
      showToast(`Cleaned flag toggled to: ${newCleaned === 1 ? '1 (CLEANED)' : '0 (RAW UNCLEANED)'}`, 'info');
    }

    function renderFormFields() {
      const container = document.getElementById('hudFieldsContainer');
      const p = activePacket.payload || {};

      let html = `
        <div class="hud-field-group">
          <label class="hud-field-label">
            <span>Packet ID</span>
            <span style="color: var(--accent-cyan); cursor: pointer;" onclick="regeneratePacketId()">🎲 Roll</span>
          </label>
          <div class="hud-field-control">
            <input type="text" class="hud-field-input" value="${activePacket.packetId}" oninput="updatePacketField('packetId', this.value)">
          </div>
        </div>

        <div class="hud-field-group">
          <label class="hud-field-label">
            <span>Ground Telemetry Flag (cleaned)</span>
            <span style="color: var(--accent-cyan); cursor: pointer; text-decoration: underline;" onclick="toggleCleanedFlag()">🔄 Click to Toggle</span>
          </label>
          <div class="hud-field-control" onclick="toggleCleanedFlag()" style="cursor: pointer;">
            <input type="text" class="hud-field-input" readonly value="${activePacket.cleaned === 1 ? '1 (CLEANED - Nominal)' : '0 (RAW UNCLEANED - Trigger FR-04)'}" style="color: ${activePacket.cleaned === 1 ? '#34d399' : '#fbbf24'}; cursor: pointer; font-weight: 700;">
          </div>
        </div>
      `;

      if (activePacket.instrument === 'ELS') {
        html += `
          <div class="hud-field-group">
            <label class="hud-field-label">Energy Range</label>
            <div class="hud-field-control">
              <input type="number" class="hud-field-input" value="${p.energyRange ?? p.rawEnergy ?? 550}" oninput="updatePayloadField('${p.rawEnergy !== undefined ? 'rawEnergy' : 'energyRange'}', Number(this.value))">
              <span class="hud-field-unit">eV</span>
            </div>
          </div>
          <div class="hud-field-group">
            <label class="hud-field-label">Electron Flux</label>
            <div class="hud-field-control">
              <input type="number" class="hud-field-input" value="${p.electronFlux ?? p.rawFlux ?? 28400}" oninput="updatePayloadField('${p.rawFlux !== undefined ? 'rawFlux' : 'electronFlux'}', Number(this.value))">
              <span class="hud-field-unit">e⁻/cm²·s</span>
            </div>
          </div>
        `;
      } else if (activePacket.instrument === 'IMA') {
        html += `
          <div class="hud-field-group">
            <label class="hud-field-label">Mass-to-charge (amu/q)</label>
            <div class="hud-field-control">
              <input type="number" class="hud-field-input" value="${p.amuPerQ ?? 16}" oninput="updatePayloadField('amuPerQ', Number(this.value))">
              <span class="hud-field-unit">amu/q</span>
            </div>
          </div>
          <div class="hud-field-group">
            <label class="hud-field-label">Ion Flux Intensity</label>
            <div class="hud-field-control">
              <input type="number" class="hud-field-input" value="${p.ionFlux ?? 9100}" oninput="updatePayloadField('ionFlux', Number(this.value))">
              <span class="hud-field-unit">ions/s</span>
            </div>
          </div>
          <div class="hud-field-group">
            <label class="hud-field-label">Sensor Elevation Angle</label>
            <div class="hud-field-control">
              <input type="number" class="hud-field-input" value="${p.angle ?? 15}" oninput="updatePayloadField('angle', Number(this.value))">
              <span class="hud-field-unit">Degrees (°)</span>
            </div>
          </div>
          <div class="hud-field-group">
            <label class="hud-field-label">Ion Energy</label>
            <div class="hud-field-control">
              <input type="number" class="hud-field-input" value="${p.energy ?? 420}" oninput="updatePayloadField('energy', Number(this.value))">
              <span class="hud-field-unit">eV</span>
            </div>
          </div>
        `;
      } else if (activePacket.instrument === 'NPD') {
        if (p.corrupt) {
          html += `
            <div class="hud-field-group" style="grid-column: 1 / -1; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 0.8rem;">
              <div style="color: #fca5a5; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.3rem;">
                🚫 CORRUPT TELEMETRY FRAME DETECTED
              </div>
              <div style="font-size: 0.78rem; color: #cbd5e1; line-height: 1.4;">
                All primary scientific channels (H-ENA flux, O-ENA flux, energy) are missing or scrambled (noiseLevel: ${p.noiseLevel || 999}). The recovery engine will classify this packet as <strong>BLOCKED</strong>.
              </div>
            </div>
          `;
        } else {
          html += `
            <div class="hud-field-group">
              <label class="hud-field-label">Hydrogen Atom Flux (H-ENA)</label>
              <div class="hud-field-control">
                <input type="number" class="hud-field-input" value="${p.hydrogenFlux ?? 1250}" oninput="updatePayloadField('hydrogenFlux', Number(this.value))">
                <span class="hud-field-unit">atoms/s</span>
              </div>
            </div>
            <div class="hud-field-group">
              <label class="hud-field-label">Oxygen Atom Flux (O-ENA)</label>
              <div class="hud-field-control">
                <input type="number" class="hud-field-input" value="${p.oxygenFlux ?? 390}" oninput="updatePayloadField('oxygenFlux', Number(this.value))">
                <span class="hud-field-unit">atoms/s</span>
              </div>
            </div>
            <div class="hud-field-group">
              <label class="hud-field-label">Energy Range</label>
              <div class="hud-field-control">
                <input type="number" class="hud-field-input" value="${p.energyRange ?? 320}" oninput="updatePayloadField('energyRange', Number(this.value))">
                <span class="hud-field-unit">eV</span>
              </div>
            </div>
          `;
        }
      }

      container.innerHTML = html;
    }

    function updatePacketField(field, val) {
      activePacket[field] = val;
      textarea.value = JSON.stringify(activePacket, null, 2);
      syncEditor();
    }

    function updatePayloadField(key, val) {
      if (!activePacket.payload) activePacket.payload = {};
      activePacket.payload[key] = val;
      textarea.value = JSON.stringify(activePacket, null, 2);
      syncEditor();
    }

    function syncEditor() {
      const text = textarea.value;
      highlightLayer.innerHTML = window.syntaxHighlightJson ? window.syntaxHighlightJson(text) : text;
      
      const lineCount = text.split('\n').length;
      let numbers = '';
      for (let i = 1; i <= Math.max(lineCount, 8); i++) {
        numbers += i + '<br>';
      }
      gutter.innerHTML = numbers;

      try {
        const obj = JSON.parse(text);
        activePacket = obj;
        document.getElementById('metaInstrument').textContent = obj.instrument || 'N/A';
        document.getElementById('metaPacketId').textContent = obj.packetId || 'UNKNOWN';
        document.getElementById('metaCleaned').textContent = obj.cleaned === 1 ? '1 (PRE-CLEANED)' : '0 (RAW UNCLEANED)';
        document.getElementById('metaCleaned').style.color = obj.cleaned === 1 ? '#34d399' : '#fbbf24';
      } catch (e) {
        // user editing invalid JSON
      }
      document.getElementById('metaBytes').textContent = new Blob([text]).size + ' B';
    }

    textarea.addEventListener('input', () => {
      syncEditor();
      if (currentMode === 'form') renderFormFields();
    });

    textarea.addEventListener('scroll', () => {
      highlightLayer.scrollTop = textarea.scrollTop;
      highlightLayer.scrollLeft = textarea.scrollLeft;
      gutter.scrollTop = textarea.scrollTop;
    });

    function selectTemplate(name) {
      currentTemplateKey = name;
      document.querySelectorAll('.template-card').forEach(c => c.classList.remove('active'));
      const card = document.getElementById('card-tpl-' + name);
      if (card) card.classList.add('active');

      const template = JSON.parse(JSON.stringify(templates[name]));
      template.packetId = "PKT-" + name + "-" + Math.floor(1000 + Math.random() * 9000);
      activePacket = template;
      textarea.value = JSON.stringify(template, null, 2);
      syncEditor();
      renderFormFields();
    }

    function regeneratePacketId() {
      const newId = "PKT-" + (activePacket.instrument || currentTemplateKey) + "-" + Math.floor(1000 + Math.random() * 9000);
      activePacket.packetId = newId;
      textarea.value = JSON.stringify(activePacket, null, 2);
      syncEditor();
      renderFormFields();
      showToast('Generated new Packet ID: ' + newId, 'info');
    }

    function formatJsonEditor() {
      try {
        const obj = JSON.parse(textarea.value);
        textarea.value = JSON.stringify(obj, null, 2);
        syncEditor();
        showToast('JSON formatted and aligned.', 'info');
      } catch (err) {
        showToast('Invalid JSON syntax: cannot format', 'error');
      }
    }

    function copyJsonToClipboard() {
      navigator.clipboard.writeText(textarea.value).then(() => {
        showToast('Payload JSON copied to clipboard!', 'success');
      }).catch(() => {
        showToast('Failed to copy to clipboard', 'error');
      });
    }

    // Modal Inspection Logic
    let currentModalPayload = '';
    function openPayloadModal(id, instrument, rawPayload) {
      currentModalPayload = rawPayload;
      document.getElementById('modalTitle').textContent = `Dataset #${id} — ${instrument} Telemetry Frame`;
      const display = document.getElementById('modalJsonDisplay');
      try {
        const parsed = JSON.parse(rawPayload);
        display.innerHTML = window.syntaxHighlightJson ? window.syntaxHighlightJson(parsed) : JSON.stringify(parsed, null, 2);
      } catch (e) {
        display.textContent = rawPayload;
      }
      document.getElementById('payloadModal').classList.add('open');
    }

    function closePayloadModal() {
      document.getElementById('payloadModal').classList.remove('open');
    }

    function copyModalJson() {
      navigator.clipboard.writeText(currentModalPayload).then(() => {
        showToast('Dataset payload copied to clipboard!', 'success');
      });
    }

    // Close modal on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePayloadModal();
    });

    // Default load ELS
    selectTemplate('ELS');

    async function submitTelemetry() {
      const rawText = textarea.value.trim();
      let body;
      try {
        body = JSON.parse(rawText);
      } catch (err) {
        showToast('Invalid JSON payload: ' + err.message, 'error');
        return;
      }

      const submitBtn = document.getElementById('btnSubmitIngest');
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.7';

      try {
        const res = await fetch('/api/telemetry/ingest', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (res.ok) {
          showToast(`Packet '${body.packetId}' successfully ingested & processed into IDFS archive!`, 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          showToast(`Ingestion Blocked: ${data.message || 'Validation error'}`, 'error');
        }
      } catch (err) {
        showToast('Network error contacting telemetry ingestion API', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    }

    async function releaseDataset(id) {
      try {
        const res = await fetch('/api/datasets/' + id + '/release', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (res.ok) {
          showToast(`Dataset #${id} released to public science dashboard!`, 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(`Release failed: ${data.message || 'Error occurred'}`, 'error');
        }
      } catch (err) {
        showToast('Network error requesting dataset release', 'error');
      }
    }
  </script>
</body>
</html>
