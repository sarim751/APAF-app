<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>APAF-Lite | ASPERA-3 / Mars Express Public Science Portal</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Homepage Specific Hero & Section Styling */
    .hero-banner {
      background: radial-gradient(circle at 50% 30%, rgba(14, 30, 64, 0.7) 0%, rgba(6, 11, 24, 0.95) 100%);
      border: 1px solid var(--border-glow);
      border-radius: 16px;
      padding: 3.5rem 2.5rem;
      margin-bottom: 3rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 30px rgba(56, 189, 248, 0.15);
    }
    .hero-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--accent-cyan), var(--accent-neon), transparent);
    }
    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.35rem 0.9rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      color: var(--accent-cyan);
      margin-bottom: 1.5rem;
      letter-spacing: 0.06em;
    }
    .hero-title {
      font-family: var(--font-heading);
      font-size: 2.75rem;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, #ffffff 30%, var(--accent-cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-subtitle {
      max-width: 760px;
      margin: 0 auto 2rem;
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.7;
    }
    .hero-stats-row {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-top: 2rem;
      padding-top: 1.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .hero-stat-chip {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--text-muted);
      background: rgba(15, 23, 42, 0.6);
      padding: 0.4rem 0.85rem;
      border-radius: 6px;
      border: 1px solid var(--border-dim);
    }
    .hero-stat-chip strong {
      color: var(--accent-cyan);
    }

    /* Instrument Selection Hub */
    .section-title-wrap {
      text-align: center;
      margin-bottom: 2rem;
    }
    .section-title-wrap h2 {
      font-family: var(--font-heading);
      font-size: 1.9rem;
      color: #ffffff;
      margin-bottom: 0.4rem;
    }
    .section-title-wrap p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .preview-hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.75rem;
      margin-bottom: 3.5rem;
    }
    .hub-card {
      background: var(--bg-card);
      border: 1px solid var(--border-glow);
      border-radius: 14px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow-hud);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .hub-card:hover {
      transform: translateY(-5px);
      border-color: rgba(56, 189, 248, 0.6);
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.85), 0 0 25px rgba(56, 189, 248, 0.2);
    }
    .hub-card-top {
      margin-bottom: 1.25rem;
    }
    .hub-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .hub-icon-title {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .hub-icon {
      font-size: 1.5rem;
    }
    .hub-title {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-main);
    }
    .hub-desc {
      color: var(--text-muted);
      font-size: 0.88rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .hub-meta-list {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      margin-bottom: 1.5rem;
      background: rgba(6, 11, 24, 0.6);
      border-radius: 8px;
      padding: 0.85rem;
      border: 1px solid var(--border-dim);
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }
    .hub-meta-item {
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
    }
    .hub-meta-item strong {
      color: var(--text-main);
    }

    /* Live Preview Stage on Homepage */
    .stage-container {
      background: rgba(11, 18, 38, 0.8);
      border: 1px solid var(--border-glow);
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 3.5rem;
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow-hud);
    }
    .stage-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.75rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-dim);
      flex-wrap: wrap;
      gap: 1rem;
    }
    .stage-tabs {
      display: inline-flex;
      background: rgba(6, 11, 24, 0.9);
      border: 1px solid var(--border-dim);
      border-radius: 8px;
      padding: 0.25rem;
      gap: 0.35rem;
    }
    .stage-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.45rem 1rem;
      border-radius: 6px;
      font-size: 0.82rem;
      font-family: var(--font-mono);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .stage-tab.active {
      background: rgba(56, 189, 248, 0.2);
      color: var(--accent-cyan);
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
    }
    .stage-content-pane {
      display: none;
      animation: hudFadeInUp 0.3s ease;
    }
    .stage-content-pane.active {
      display: block;
    }

    /* Operations CTA Banner */
    .cta-card {
      background: linear-gradient(135deg, rgba(14, 30, 64, 0.8) 0%, rgba(30, 58, 102, 0.6) 100%);
      border: 1px solid var(--border-glow);
      border-radius: 14px;
      padding: 2.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--shadow-hud);
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .cta-text h3 {
      font-family: var(--font-heading);
      font-size: 1.35rem;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }
    .cta-text p {
      color: var(--text-muted);
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <canvas id="spaceCanvas"></canvas>

  <div class="content-wrapper">
    <!-- Top Mission Status Bar -->
    <div class="mission-status-bar">
      <div class="mission-indicator">
        <span class="pulse-dot"></span>
        <span>ESA / ESOC LINK: <strong style="color: var(--accent-emerald);">NOMINAL (ONLINE)</strong></span>
      </div>
      <div class="mission-clocks">
        <span id="marsSol">MEX ORBIT #23842</span>
        <span id="utcClock">UTC --:--:--</span>
      </div>
    </div>

    <!-- Header -->
    <header>
      <div class="title-group">
        <h1>ASPERA-3 / Mars Express Public Science Portal</h1>
        <p>
          <span style="color: var(--accent-cyan); font-weight: 600;">APAF-Lite</span>
          &bull; Automated Ground Data Reduction & Archiving Facility
        </p>
      </div>
      <div class="nav-cluster">
        <a href="/preview" class="btn">
          <span>📊 Full Telemetry Matrix</span>
        </a>
        <% if (user) { %>
          <a href="/science/dashboard" class="btn btn-primary">
            <span>🔬 Science Console</span>
            <span style="opacity: 0.8; font-size: 0.8em;">(<%= user.username %>)</span>
          </a>
          <a href="/auth/logout" class="btn">Sign Out</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-primary">
            <span>🔐 Science Team Login &rarr;</span>
          </a>
        <% } %>
      </div>
    </header>

    <main>
      <!-- Hero Banner -->
      <section class="hero-banner">
        <div class="hero-tag">
          <span class="pulse-dot"></span>
          MARS EXPRESS SCIENTIFIC DOWNLINK &bull; SWRI / IRF APAF GROUND SYSTEM
        </div>
        <h1 class="hero-title">Planetary Space Plasma &<br>Energetic Atoms Investigation</h1>
        <p class="hero-subtitle">
          Welcome to the public data access gateway for the ASPERA-3 experiment aboard ESA's Mars Express orbiter.
          Preview real-time electron fluxes, ion mass-to-charge spectra, and energetic neutral atom emissions.
        </p>

        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="#previewHub" class="btn btn-primary" style="padding: 0.75rem 1.6rem; font-size: 1rem;">
            <span>🔭 Explore Data Previews &darr;</span>
          </a>
          <a href="/preview" class="btn" style="padding: 0.75rem 1.6rem; font-size: 1rem;">
            <span>📈 View All Released Datasets &rarr;</span>
          </a>
        </div>

        <div class="hero-stats-row">
          <div class="hero-stat-chip">
            <span>SPACECRAFT:</span>
            <strong>Mars Express (ESA)</strong>
          </div>
          <div class="hero-stat-chip">
            <span>ORBIT:</span>
            <strong>Polar Elliptical (Periapsis ~300 km)</strong>
          </div>
          <div class="hero-stat-chip">
            <span>SENSORS:</span>
            <strong>ELS &bull; IMA &bull; NPD &bull; NPI</strong>
          </div>
          <div class="hero-stat-chip">
            <span>FORMAT:</span>
            <strong>NASA PDS / IDFS Compliant</strong>
          </div>
        </div>
      </section>

      <!-- Data Preview Options Hub -->
      <section id="previewHub">
        <div class="section-title-wrap">
          <h2>Select Instrument Telemetry to Preview</h2>
          <p>Choose an ASPERA-3 sensor component to inspect active datasets, physical measurements, and spectral graphs</p>
        </div>

        <div class="preview-hub-grid">
          <!-- ELS Option Card -->
          <div class="hub-card">
            <div class="hub-card-top">
              <div class="hub-card-header">
                <div class="hub-icon-title">
                  <span class="hub-icon">⚡</span>
                  <div>
                    <h3 class="hub-title">ELS Spectrometer</h3>
                    <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);">SENSOR CHANNEL 01</span>
                  </div>
                </div>
                <% if (instruments.ELS) { %>
                  <span class="badge badge-live">● RELEASED</span>
                <% } else { %>
                  <span class="badge badge-none">PENDING</span>
                <% } %>
              </div>

              <p class="hub-desc">
                Measures solar wind and ionospheric electron fluxes across high and low energies (0.001 to 20 keV) with 4π steradian spatial coverage.
              </p>

              <div class="hub-meta-list">
                <div class="hub-meta-item">
                  <span>Target Particle:</span>
                  <strong>Electrons (e⁻)</strong>
                </div>
                <div class="hub-meta-item">
                  <span>Current Energy:</span>
                  <strong><%= instruments.ELS ? instruments.ELS.data_json.energyRange + ' eV' : 'Nominal 550 eV' %></strong>
                </div>
                <div class="hub-meta-item">
                  <span>Status:</span>
                  <strong style="color: <%= instruments.ELS ? '#34d399' : 'var(--text-dim)' %>;">
                    <%= instruments.ELS ? 'Active Ingested Dataset #' + instruments.ELS.id : 'Awaiting Approval' %>
                  </strong>
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 0.6rem;">
              <button type="button" class="btn btn-primary" style="flex-grow: 1; justify-content: center;" onclick="switchLiveStage('ELS')">
                <span>👁️ Preview In-Page</span>
              </button>
              <a href="/preview?instrument=ELS" class="btn" title="Full ELS view">
                <span>&rarr;</span>
              </a>
            </div>
          </div>

          <!-- IMA Option Card -->
          <div class="hub-card">
            <div class="hub-card-top">
              <div class="hub-card-header">
                <div class="hub-icon-title">
                  <span class="hub-icon">🧬</span>
                  <div>
                    <h3 class="hub-title">IMA Mass Analyzer</h3>
                    <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);">SENSOR CHANNEL 02</span>
                  </div>
                </div>
                <% if (instruments.IMA) { %>
                  <span class="badge badge-live">● RELEASED</span>
                <% } else { %>
                  <span class="badge badge-none">PENDING</span>
                <% } %>
              </div>

              <p class="hub-desc">
                Measures the ion mass composition (1–10⁶ amu/q), energy distributions, and 3D angle spectra of plasma escaping the Martian atmosphere.
              </p>

              <div class="hub-meta-list">
                <div class="hub-meta-item">
                  <span>Target Particle:</span>
                  <strong>Positive Ions (H⁺, O⁺, O₂⁺)</strong>
                </div>
                <div class="hub-meta-item">
                  <span>Mass-to-charge:</span>
                  <strong><%= instruments.IMA ? instruments.IMA.data_json.amuPerQ + ' amu/q' : '1–10⁶ amu/q' %></strong>
                </div>
                <div class="hub-meta-item">
                  <span>Status:</span>
                  <strong style="color: <%= instruments.IMA ? '#f59e0b' : 'var(--text-dim)' %>;">
                    <%= instruments.IMA ? 'Active Ingested Dataset #' + instruments.IMA.id : 'Awaiting Approval' %>
                  </strong>
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 0.6rem;">
              <button type="button" class="btn btn-primary" style="flex-grow: 1; justify-content: center;" onclick="switchLiveStage('IMA')">
                <span>👁️ Preview In-Page</span>
              </button>
              <a href="/preview?instrument=IMA" class="btn" title="Full IMA view">
                <span>&rarr;</span>
              </a>
            </div>
          </div>

          <!-- NPD Option Card -->
          <div class="hub-card">
            <div class="hub-card-top">
              <div class="hub-card-header">
                <div class="hub-icon-title">
                  <span class="hub-icon">⚛️</span>
                  <div>
                    <h3 class="hub-title">NPD Neutral Detector</h3>
                    <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);">SENSOR CHANNEL 03</span>
                  </div>
                </div>
                <% if (instruments.NPD) { %>
                  <span class="badge badge-live">● RELEASED</span>
                <% } else { %>
                  <span class="badge badge-none">PENDING</span>
                <% } %>
              </div>

              <p class="hub-desc">
                Measures mass/energy resolved energetic neutral hydrogen (H-ENA) and oxygen (O-ENA) atoms generated by solar wind charge exchange.
              </p>

              <div class="hub-meta-list">
                <div class="hub-meta-item">
                  <span>Target Particle:</span>
                  <strong>Neutral Atoms (H, O)</strong>
                </div>
                <div class="hub-meta-item">
                  <span>Energy Resolution:</span>
                  <strong>0.1 to 100 keV</strong>
                </div>
                <div class="hub-meta-item">
                  <span>Status:</span>
                  <strong style="color: <%= instruments.NPD ? '#f97316' : 'var(--text-dim)' %>;">
                    <%= instruments.NPD ? 'Active Ingested Dataset #' + instruments.NPD.id : 'Awaiting Approval' %>
                  </strong>
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 0.6rem;">
              <button type="button" class="btn btn-primary" style="flex-grow: 1; justify-content: center;" onclick="switchLiveStage('NPD')">
                <span>👁️ Preview In-Page</span>
              </button>
              <a href="/preview?instrument=NPD" class="btn" title="Full NPD view">
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Interactive In-Page Live Preview Stage -->
      <section class="stage-container" id="liveStageSection">
        <div class="stage-header">
          <div>
            <h3 style="font-family: var(--font-heading); font-size: 1.35rem; color: var(--accent-cyan); display: flex; align-items: center; gap: 0.5rem;">
              <span class="pulse-dot"></span>
              Live Telemetry Preview Stage
            </h3>
            <span style="font-size: 0.82rem; color: var(--text-muted);">Real-time physical telemetry meters for the selected instrument</span>
          </div>

          <div class="stage-tabs">
            <button type="button" class="stage-tab active" id="tab-ELS" onclick="switchLiveStage('ELS')">⚡ ELS Electron</button>
            <button type="button" class="stage-tab" id="tab-IMA" onclick="switchLiveStage('IMA')">🧬 IMA Ion Mass</button>
            <button type="button" class="stage-tab" id="tab-NPD" onclick="switchLiveStage('NPD')">⚛️ NPD Neutral</button>
          </div>
        </div>

        <!-- ELS Preview Pane -->
        <div class="stage-content-pane active" id="pane-ELS">
          <% if (instruments.ELS) { 
               const flux = instruments.ELS.data_json.electronFlux || 0;
               const energy = instruments.ELS.data_json.energyRange || 0;
               const fluxPct = Math.min(Math.max((flux / 40000) * 100, 8), 100);
               const energyPct = Math.min(Math.max((energy / 1000) * 100, 8), 100);
          %>
            <div class="telemetry-gauge-box">
              <div class="gauge-row">
                <div class="gauge-label">
                  <span>ELECTRON FLUX (e⁻/cm²·s)</span>
                  <span style="color: var(--accent-cyan); font-weight: 600;"><%= Number(flux).toLocaleString() %></span>
                </div>
                <div class="gauge-track">
                  <div class="gauge-fill" style="width: <%= fluxPct %>%;"></div>
                </div>
              </div>
              <div class="gauge-row" style="margin-top: 0.85rem;">
                <div class="gauge-label">
                  <span>ENERGY RANGE (eV)</span>
                  <span style="color: var(--accent-cyan); font-weight: 600;"><%= energy %> eV</span>
                </div>
                <div class="gauge-track">
                  <div class="gauge-fill" style="width: <%= energyPct %>%;"></div>
                </div>
              </div>
            </div>

            <div class="metric-tiles-grid">
              <div class="metric-tile">
                <span class="metric-tile-title">Electron Flux</span>
                <span class="metric-tile-value"><%= Number(flux).toLocaleString() %><span class="metric-tile-unit">e⁻/cm²·s</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Energy Range</span>
                <span class="metric-tile-value"><%= energy %><span class="metric-tile-unit">eV</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Field of View</span>
                <span class="metric-tile-value" style="font-size: 0.95rem; color: #a5f3fc;">4π Steradian</span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Archived Dataset</span>
                <span class="metric-tile-value" style="font-size: 0.95rem; color: var(--accent-cyan);">IDFS #<%= instruments.ELS.id %></span>
              </div>
            </div>

            <button type="button" class="raw-drawer-trigger" onclick="toggleStageRaw('els')">
              <span>&lt;/&gt; Raw IDFS Telemetry JSON</span>
              <span id="stage-arrow-els">&#9662;</span>
            </button>
            <div class="raw-drawer-content" id="stage-drawer-els">
              <div class="code-viewer">
                <pre><%= JSON.stringify(instruments.ELS.data_json, null, 2) %></pre>
              </div>
            </div>
          <% } else { %>
            <div class="telemetry-gauge-box" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              Telemetry packet received. Currently awaiting science team release authorization.
            </div>
          <% } %>
        </div>

        <!-- IMA Preview Pane -->
        <div class="stage-content-pane" id="pane-IMA">
          <% if (instruments.IMA) { 
               const ionFlux = instruments.IMA.data_json.ionFlux || 0;
               const amu = instruments.IMA.data_json.amuPerQ || 1;
               const angle = instruments.IMA.data_json.angle || 0;
               const energy = instruments.IMA.data_json.energy || 100;
               const amuLogPct = Math.min(Math.max((Math.log10(amu + 1) / 6) * 100, 10), 100);
               const ionFluxPct = Math.min(Math.max((ionFlux / 15000) * 100, 10), 100);
          %>
            <div class="telemetry-gauge-box">
              <div class="gauge-row">
                <div class="gauge-label">
                  <span>ION FLUX INTENSITY</span>
                  <span style="color: var(--accent-amber); font-weight: 600;"><%= Number(ionFlux).toLocaleString() %> ions/s</span>
                </div>
                <div class="gauge-track">
                  <div class="gauge-fill gauge-fill-amber" style="width: <%= ionFluxPct %>%;"></div>
                </div>
              </div>
              <div class="gauge-row" style="margin-top: 0.85rem;">
                <div class="gauge-label">
                  <span>MASS-TO-CHARGE (amu/q)</span>
                  <span style="color: var(--accent-amber); font-weight: 600;"><%= amu %> amu/q</span>
                </div>
                <div class="gauge-track">
                  <div class="gauge-fill gauge-fill-amber" style="width: <%= amuLogPct %>%;"></div>
                </div>
              </div>
            </div>

            <div class="metric-tiles-grid">
              <div class="metric-tile">
                <span class="metric-tile-title">Mass-to-charge</span>
                <span class="metric-tile-value" style="color: #fde047;"><%= amu %><span class="metric-tile-unit" style="color: var(--accent-amber);">amu/q</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Ion Flux</span>
                <span class="metric-tile-value" style="color: #fde047;"><%= Number(ionFlux).toLocaleString() %><span class="metric-tile-unit" style="color: var(--accent-amber);">ions/s</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Ion Energy</span>
                <span class="metric-tile-value"><%= energy %><span class="metric-tile-unit">eV</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Elevation Angle</span>
                <span class="metric-tile-value"><%= angle %>°<span class="metric-tile-unit">Arrival</span></span>
              </div>
            </div>

            <button type="button" class="raw-drawer-trigger" onclick="toggleStageRaw('ima')">
              <span>&lt;/&gt; Raw IDFS Telemetry JSON</span>
              <span id="stage-arrow-ima">&#9662;</span>
            </button>
            <div class="raw-drawer-content" id="stage-drawer-ima">
              <div class="code-viewer">
                <pre><%= JSON.stringify(instruments.IMA.data_json, null, 2) %></pre>
              </div>
            </div>
          <% } else { %>
            <div class="telemetry-gauge-box" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              Telemetry packet received. Currently awaiting science team release authorization.
            </div>
          <% } %>
        </div>

        <!-- NPD Preview Pane -->
        <div class="stage-content-pane" id="pane-NPD">
          <% if (instruments.NPD) { 
               const hFlux = instruments.NPD.data_json.hydrogenFlux || 0;
               const oFlux = instruments.NPD.data_json.oxygenFlux || 0;
               const energy = instruments.NPD.data_json.energyRange || 300;
               const hPct = Math.min(Math.max((hFlux / 3000) * 100, 8), 100);
               const oPct = Math.min(Math.max((oFlux / 1000) * 100, 8), 100);
          %>
            <div class="telemetry-gauge-box">
              <div class="gauge-row">
                <div class="gauge-label">
                  <span>HYDROGEN ATOM FLUX (H-ENA)</span>
                  <span style="color: var(--accent-mars); font-weight: 600;"><%= Number(hFlux).toLocaleString() %></span>
                </div>
                <div class="gauge-track">
                  <div class="gauge-fill gauge-fill-mars" style="width: <%= hPct %>%;"></div>
                </div>
              </div>
              <div class="gauge-row" style="margin-top: 0.85rem;">
                <div class="gauge-label">
                  <span>OXYGEN ATOM FLUX (O-ENA)</span>
                  <span style="color: var(--accent-mars); font-weight: 600;"><%= Number(oFlux).toLocaleString() %></span>
                </div>
                <div class="gauge-track">
                  <div class="gauge-fill gauge-fill-mars" style="width: <%= oPct %>%;"></div>
                </div>
              </div>
            </div>

            <div class="metric-tiles-grid">
              <div class="metric-tile">
                <span class="metric-tile-title">Hydrogen Flux</span>
                <span class="metric-tile-value" style="color: #fb923c;"><%= Number(hFlux).toLocaleString() %><span class="metric-tile-unit" style="color: var(--accent-mars);">atoms/s</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Oxygen Flux</span>
                <span class="metric-tile-value" style="color: #fb923c;"><%= Number(oFlux).toLocaleString() %><span class="metric-tile-unit" style="color: var(--accent-mars);">atoms/s</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Energy Band</span>
                <span class="metric-tile-value"><%= energy %><span class="metric-tile-unit">eV</span></span>
              </div>
              <div class="metric-tile">
                <span class="metric-tile-title">Species Resolution</span>
                <span class="metric-tile-value" style="font-size: 0.95rem; color: #fed7aa;">H / O Resolv.</span>
              </div>
            </div>

            <button type="button" class="raw-drawer-trigger" onclick="toggleStageRaw('npd')">
              <span>&lt;/&gt; Raw IDFS Telemetry JSON</span>
              <span id="stage-arrow-npd">&#9662;</span>
            </button>
            <div class="raw-drawer-content" id="stage-drawer-npd">
              <div class="code-viewer">
                <pre><%= JSON.stringify(instruments.NPD.data_json, null, 2) %></pre>
              </div>
            </div>
          <% } else { %>
            <div class="telemetry-gauge-box" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              Telemetry packet received. Currently awaiting science team release authorization.
            </div>
          <% } %>
        </div>
      </section>

      <!-- Operations Access Call to Action -->
      <section class="cta-card">
        <div class="cta-text">
          <h3>ASPERA-3 Science Team Access</h3>
          <p>Require ingestion pipeline controls, raw telemetry ingestion, or full dataset history access?</p>
        </div>
        <a href="/auth/login" class="btn btn-primary" style="padding: 0.65rem 1.4rem;">
          <span>Enter Operations Console &rarr;</span>
        </a>
      </section>
    </main>

    <!-- Footer -->
    <footer>
      <div>ASPERA-3 Processing and Archiving Facility (APAF-Lite) &bull; Southwest Research Institute &bull; IRF</div>
      <div style="font-family: var(--font-mono); color: var(--accent-cyan);">MARS EXPRESS GROUND SEGMENT</div>
    </footer>
  </div>

  <script src="/js/space-fx.js"></script>
  <script>
    function switchLiveStage(inst) {
      document.querySelectorAll('.stage-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.stage-content-pane').forEach(p => p.classList.remove('active'));

      const activeTab = document.getElementById('tab-' + inst);
      const activePane = document.getElementById('pane-' + inst);

      if (activeTab) activeTab.classList.add('active');
      if (activePane) activePane.classList.add('active');

      // Scroll smoothly to stage
      const stageSection = document.getElementById('liveStageSection');
      if (stageSection) {
        stageSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function toggleStageRaw(id) {
      const drawer = document.getElementById('stage-drawer-' + id);
      const arrow = document.getElementById('stage-arrow-' + id);
      if (drawer) {
        drawer.classList.toggle('open');
        arrow.innerHTML = drawer.classList.contains('open') ? '&#9652;' : '&#9662;';
      }
    }
  </script>
</body>
</html>
