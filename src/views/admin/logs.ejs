<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>APAF-Lite | System Audit & Error Logs</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --success: #22c55e;
      --warning: #eab308;
      --error: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 2rem 1rem;
    }
    .container { max-width: 1200px; margin: 0 auto; }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .title-group h1 { font-size: 1.75rem; color: var(--accent); }
    .title-group p { color: var(--muted); font-size: 0.9rem; }
    .btn {
      display: inline-block;
      padding: 0.45rem 0.9rem;
      border-radius: 6px;
      font-size: 0.85rem;
      text-decoration: none;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
    }
    .filter-bar {
      margin-bottom: 1rem;
      display: flex;
      gap: 1rem;
      align-items: center;
    }
    select {
      background: #0b1120;
      color: var(--text);
      border: 1px solid var(--border);
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      font-size: 0.875rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    th, td {
      padding: 0.75rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 0.85rem;
    }
    th {
      background: #172033;
      color: var(--muted);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
    }
    .badge {
      font-size: 0.75rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-weight: 700;
      font-family: monospace;
    }
    .badge-INFO { background: rgba(56, 189, 248, 0.15); color: var(--accent); }
    .badge-WARNING { background: rgba(234, 179, 8, 0.15); color: var(--warning); }
    .badge-ERROR { background: rgba(239, 68, 68, 0.15); color: var(--error); }
    code { font-family: monospace; color: var(--accent); }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="title-group">
        <h1>System Logs & Audit Trail</h1>
        <p>Built-in Error Handling & Activity Monitoring (APAF-FR-09)</p>
      </div>
      <div>
        <a href="/science/dashboard" class="btn">&larr; Back to Science Dashboard</a>
      </div>
    </header>

    <div class="filter-bar">
      <label for="severitySelect">Filter Severity:</label>
      <select id="severitySelect" onchange="filterLogs(this.value)">
        <option value="" <%= !selectedSeverity ? 'selected' : '' %>>All Severities</option>
        <option value="INFO" <%= selectedSeverity === 'INFO' ? 'selected' : '' %>>INFO</option>
        <option value="WARNING" <%= selectedSeverity === 'WARNING' ? 'selected' : '' %>>WARNING</option>
        <option value="ERROR" <%= selectedSeverity === 'ERROR' ? 'selected' : '' %>>ERROR</option>
      </select>
      <span style="color: var(--muted); font-size: 0.85rem;">Showing <%= logs.length %> entries</span>
    </div>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Severity</th>
          <th>Code</th>
          <th>Message</th>
          <th>Context</th>
          <th>Timestamp</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs.length === 0) { %>
          <tr><td colspan="6" style="text-align: center; color: var(--muted); padding: 2rem;">No logs found.</td></tr>
        <% } %>
        <% logs.forEach(function(log) { %>
          <tr>
            <td>#<%= log.id %></td>
            <td><span class="badge badge-<%= log.severity %>"><%= log.severity %></span></td>
            <td><code><%= log.code %></code></td>
            <td><%= log.message %></td>
            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 0.75rem; color: var(--muted);">
              <%= log.context_json ? (typeof log.context_json === 'string' ? log.context_json : JSON.stringify(log.context_json)) : '-' %>
            </td>
            <td style="font-size: 0.8rem; color: var(--muted); white-space: nowrap;"><%= new Date(log.created_at).toLocaleString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <script>
    function filterLogs(val) {
      if (val) {
        window.location.href = '/admin/logs?severity=' + val;
      } else {
        window.location.href = '/admin/logs';
      }
    }
  </script>
</body>
</html>
