<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>APAF-Lite | Operations Audit & System Logs</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(11, 18, 38, 0.8);
      border: 1px solid var(--border-glow);
      border-radius: 10px;
      padding: 0.85rem 1.25rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(12px);
    }
    .custom-select {
      background: rgba(4, 8, 19, 0.9);
      color: var(--accent-cyan);
      border: 1px solid var(--border-glow);
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-family: var(--font-mono);
      outline: none;
    }
    .badge-INFO {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.35);
    }
    .badge-WARNING {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.35);
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
    }
    .badge-ERROR {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.35);
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.25);
    }
  </style>
</head>
<body>
  <canvas id="spaceCanvas"></canvas>

  <div class="content-wrapper">
    <!-- Top Mission Status Bar -->
    <div class="mission-status-bar">
      <div class="mission-indicator">
        <span class="pulse-dot"></span>
        <span>GROUND SEGMENT AUDIT TRAIL &bull; APAF-FR-09 & APAF-DS-OI-2</span>
      </div>
      <div class="mission-clocks">
        <span id="marsSol">MEX ORBIT #23842</span>
        <span id="utcClock">UTC --:--:--</span>
      </div>
    </div>

    <!-- Header -->
    <header>
      <div class="title-group">
        <h1>System Logs & Flight Diagnostics</h1>
        <p>Real-time audit log of packet arrivals, cleanup anomalies, IDFS generation, and security events</p>
      </div>
      <div class="nav-cluster">
        <a href="/science/dashboard" class="btn btn-primary">
          <span>🔬 Science Console &rarr;</span>
        </a>
      </div>
    </header>

    <main>
      <!-- Filter Controls -->
      <div class="filter-bar">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <label for="severitySelect" style="font-size: 0.82rem; font-family: var(--font-mono); color: var(--text-muted); text-transform: uppercase;">
            Severity Filter:
          </label>
          <select id="severitySelect" class="custom-select" onchange="filterLogs(this.value)">
            <option value="" <%= !selectedSeverity ? 'selected' : '' %>>ALL SEVERITIES</option>
            <option value="INFO" <%= selectedSeverity === 'INFO' ? 'selected' : '' %>>INFO ONLY</option>
            <option value="WARNING" <%= selectedSeverity === 'WARNING' ? 'selected' : '' %>>WARNING ONLY</option>
            <option value="ERROR" <%= selectedSeverity === 'ERROR' ? 'selected' : '' %>>ERROR ONLY</option>
          </select>
        </div>
        <div style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted);">
          SHOWING <strong style="color: var(--accent-cyan);"><%= logs.length %></strong> LOGGED EVENTS
        </div>
      </div>

      <!-- Logs Table -->
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Severity</th>
              <th>Code</th>
              <th>Message</th>
              <th>Context</th>
              <th>Recorded Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (logs.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                  No system logs matched the requested filter.
                </td>
              </tr>
            <% } %>
            <% logs.forEach(function(log) { %>
              <tr>
                <td style="font-family: var(--font-mono); font-weight: 700; color: var(--accent-cyan);">
                  #<%= log.id %>
                </td>
                <td>
                  <span class="badge badge-<%= log.severity %>">
                    <%= log.severity %>
                  </span>
                </td>
                <td>
                  <code style="font-family: var(--font-mono); color: var(--text-main); font-size: 0.82rem;">
                    <%= log.code %>
                  </code>
                </td>
                <td style="color: #e2e8f0; font-size: 0.88rem;">
                  <%= log.message %>
                </td>
                <td>
                  <% 
                    let ctxObj = null;
                    try {
                      ctxObj = typeof log.context_json === 'string' ? JSON.parse(log.context_json) : log.context_json;
                    } catch(e) {}
                  %>
                  <% if (ctxObj && typeof ctxObj === 'object') { %>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; max-width: 320px;">
                      <% Object.keys(ctxObj).slice(0, 3).forEach(function(k) { %>
                        <span class="param-chip" style="padding: 0.15rem 0.45rem; font-size: 0.7rem;">
                          <span class="param-chip-key"><%= k %>:</span>
                          <span class="param-chip-val"><%= typeof ctxObj[k] === 'object' ? '...' : ctxObj[k] %></span>
                        </span>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <span style="color: var(--text-dim); font-family: var(--font-mono); font-size: 0.75rem;">-</span>
                  <% } %>
                </td>
                <td style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); white-space: nowrap;">
                  <%= new Date(log.created_at).toLocaleString() %>
                </td>

              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </main>

    <!-- Footer -->
    <footer>
      <div>ASPERA-3 Processing and Archiving Facility (APAF-Lite) &bull; Diagnostic Interface</div>
      <div style="font-family: var(--font-mono); color: var(--accent-cyan);">AUDIT ENGINE: ONLINE</div>
    </footer>
  </div>

  <script src="/js/space-fx.js"></script>
  <script>
    function filterLogs(val) {
      if (val) {
        window.location.href = '/admin/logs?severity=' + val;
      } else {
        window.location.href = '/admin/logs';
      }
    }
  </script>
</body>
</html>
